{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nikonotnicotine/uranus-plugins/schema/delisted.schema.json",
  "title": "Uranus 插件市场下架名单",
  "description": "已经从目录摘掉的插件。条目**不删**只移到这里 —— 客户端拉到这份名单后，会对本地已安装的同 id 插件亮红色警告。审核总会漏，召回不能漏。",
  "type": "object",
  "required": ["version", "updatedAt", "plugins"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "updatedAt": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "title", "delistedAt", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "和 plugins.json 里那条的 id 一致。客户端靠它匹配本地已装的插件。",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 40 },
        "repo": {
          "description": "可选。仓库已被作者删除或转为私有时留空。",
          "type": "string",
          "pattern": "^https://github\\.com/"
        },
        "delistedAt": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "reason": {
          "description": "下架原因。security 这一档会让客户端弹更重的警告，别拿它当「作者弃坑了」用。",
          "enum": [
            "security",
            "paid-content",
            "license",
            "author-request",
            "repo-gone",
            "broken",
            "other"
          ]
        },
        "note": {
          "description": "给用户看的一句话说明。security 那一档必须写，让人知道该不该立刻卸载。",
          "type": "string",
          "maxLength": 200
        }
      },
      "allOf": [
        {
          "if": { "properties": { "reason": { "const": "security" } }, "required": ["reason"] },
          "then": { "required": ["note"] }
        }
      ]
    }
  }
}
